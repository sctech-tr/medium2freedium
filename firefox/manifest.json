{
  "manifest_version": 2,
  "name": "Medium to Freedium",
  "version": "1.1",
  "description": "Adds https://freedium-mirror.cfd/ to Medium URLs.",
  "permissions": ["tabs", "webRequest", "webRequestBlocking", "*://*.medium.com/*"],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_popup": "popup.html"
  },
  "applications": {
    "gecko": {
      "id": "{54d80c0d-ccca-4113-8ed2-eeedca322a60}"
    }
  }
}
